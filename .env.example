NODE_ENV=development
DATABASE_URL=postgresql://platform:local_dev_password@localhost:5432/platform?schema=public
REDIS_URL=redis://localhost:6379
# X1 — one shared prefix across ALL services: the kit's JWT strategy reads the
# token blacklist (bl:access:*) through it.
REDIS_KEY_PREFIX=nb:
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=REPLACE_ME_min_32_chars_random
# auth-service only — refresh tokens get their own secret (falls back to JWT_SECRET)
JWT_REFRESH_SECRET=REPLACE_ME_other_32_chars_random
JWT_ISSUER=platform
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
# nutrition-service — D3: food data provider ("mock" for dev/CI determinism,
# "openfoodfacts" in prod; defaults follow NODE_ENV)
FOOD_PROVIDER=mock
# Dev/e2e: relax the per-service throttle so repeated runs aren't 429'd (prod unset → 100/60s)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100000
