NODE_ENV=development
DATABASE_URL=postgresql://platform:local_dev_password@localhost:5432/platform?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=REPLACE_ME_min_32_chars_random
JWT_ISSUER=platform
# Dev/e2e: relax the per-service throttle so repeated runs aren't 429'd (prod unset → 100/60s)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100000
