// Platform skeleton — generic Prisma schema. Replace the example models with
// your product's domain. PostGIS is enabled to demo the `geo` helper; uuid PKs
// are DB-generated (raw-SQL inserts omit id) — keep that convention.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

/// A platform user. Tokens are minted by your auth service; other services
/// verify-only (see @platform/service-kit AuthModule).
model User {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique @db.VarChar(200)
  full_name  String   @db.VarChar(100)
  auth_level Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @default(now()) @db.Timestamptz()

  places Place[]
  audit_logs AuditLog[]
  offline_queue_entries OfflineQueue[]

  @@map("users")
}

/// Example geo-bearing model (demonstrates the `geo` helper + raw-SQL pattern).
model Place {
  id         String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id   String                              @db.Uuid
  name       String                              @db.VarChar(200)
  location   Unsupported("geometry(Point, 4326)")
  created_at DateTime                            @default(now()) @db.Timestamptz()
  updated_at DateTime                            @updatedAt @default(now()) @db.Timestamptz()

  owner User @relation(fields: [owner_id], references: [id])

  @@index([owner_id])
  @@map("places")
}

/// Generic audit trail written by the kit's AuditInterceptor.
model AuditLog {
  id            String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?  @db.Uuid
  action        String   @db.VarChar(100)
  resource_type String   @db.VarChar(50)
  resource_id   String?  @db.Uuid
  ip_address    String?  @db.Inet
  user_agent    String?
  changes       Json     @db.JsonB
  timestamp     DateTime @default(now()) @db.Timestamptz()

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@id([id, timestamp])
  @@index([user_id, timestamp])
  @@map("audit_logs")
}

// =============================================================================
// OFFLINE-FIRST SYNC — model shapes for @platform/service-kit's SyncEngine
// (idempotent replay + entity versioning; see the offline-first-mobile skill)
// =============================================================================

model OfflineQueue {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @db.Uuid
  device_id           String    @db.VarChar(200)
  client_op_id        String    @unique @db.Uuid
  operation_type      String    @db.VarChar(20)
  entity_type         String    @db.VarChar(40)
  entity_id           String?   @db.Uuid
  payload             Json      @db.JsonB
  priority            Int       @default(3)
  status              String    @default("pending") @db.VarChar(20)
  conflict_resolution String    @default("server_wins") @db.VarChar(30)
  expected_version    Int?
  client_timestamp    DateTime  @db.Timestamptz()
  server_received_at  DateTime  @default(now()) @db.Timestamptz()
  processed_at        DateTime? @db.Timestamptz()
  expires_at          DateTime  @db.Timestamptz()
  retry_count         Int       @default(0)
  error_message       String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status, priority])
  @@index([entity_type, entity_id])
  @@index([expires_at])
  @@map("offline_queue")
}

model EntityVersion {
  entity_type String   @db.VarChar(40)
  entity_id   String   @db.Uuid
  version     BigInt   @default(1)
  updated_at  DateTime @default(now()) @db.Timestamptz()

  @@id([entity_type, entity_id])
  @@map("entity_versions")
}
