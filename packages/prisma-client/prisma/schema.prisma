// NutriBalance domain schema. uuid PKs are DB-generated (raw-SQL inserts omit
// id) — keep that convention. PostGIS stays enabled for the kit's `geo` helper
// even though no NutriBalance table carries geometry yet.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

/// A NutriBalance account. Tokens are minted by auth-service; every other
/// service verify-only (see @platform/service-kit AuthModule).
model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(200)
  password_hash String   @db.VarChar(100)
  full_name     String   @db.VarChar(100)
  auth_level    Int      @default(1)
  locale        String   @default("fr") @db.VarChar(10)
  created_at    DateTime @default(now()) @db.Timestamptz()
  updated_at    DateTime @updatedAt @default(now()) @db.Timestamptz()

  profile               Profile?
  weight_entries        WeightEntry[]
  custom_foods          FoodItem[]
  journal_entries       JournalEntry[]
  favorite_foods        FavoriteFood[]
  audit_logs            AuditLog[]
  offline_queue_entries OfflineQueue[]

  @@map("users")
}

/// É1 — profile & onboarding: the inputs of the BMR/TDEE/macro target
/// computation (profile-service recomputes targets on read; nothing derived is
/// stored here — see computeTargets).
model Profile {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @unique @db.Uuid
  sex              String    @db.VarChar(10) // male | female
  birth_date       DateTime  @db.Date
  height_cm        Decimal   @db.Decimal(5, 1)
  weight_kg        Decimal   @db.Decimal(5, 2) // current weight, synced from the latest WeightEntry
  activity_level   String    @db.VarChar(20) // sedentary | light | moderate | active | very_active
  goal             String    @db.VarChar(20) // lose | maintain | gain | recomp
  target_weight_kg Decimal?  @db.Decimal(5, 2)
  target_date      DateTime? @db.Date
  training_level   String?   @db.VarChar(20) // beginner | intermediate | advanced
  equipment        String?   @db.VarChar(10) // none | home | gym
  created_at       DateTime  @default(now()) @db.Timestamptz()
  updated_at       DateTime  @updatedAt @default(now()) @db.Timestamptz()

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// É7 — progress: the weight curve. One row per measurement.
model WeightEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  weight_kg   Decimal  @db.Decimal(5, 2)
  measured_at DateTime @default(now()) @db.Timestamptz()
  created_at  DateTime @default(now()) @db.Timestamptz()

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, measured_at])
  @@map("weight_entries")
}

/// É3 — a food, either cached from OpenFoodFacts (`source = "off"`, global,
/// keyed by barcode) or user-created (`source = "custom"`, owned). Nutrition
/// is normalised per 100 g; journal entries snapshot their own numbers so
/// editing a food never rewrites history.
model FoodItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source            String   @db.VarChar(10) // off | custom
  off_barcode       String?  @unique @db.VarChar(40)
  owner_id          String?  @db.Uuid // custom foods only; OFF cache rows are global
  name              String   @db.VarChar(200)
  brand             String?  @db.VarChar(120)
  kcal_per_100g     Decimal  @db.Decimal(7, 2)
  protein_per_100g  Decimal  @db.Decimal(6, 2)
  carbs_per_100g    Decimal  @db.Decimal(6, 2)
  fat_per_100g      Decimal  @db.Decimal(6, 2)
  serving_size_g    Decimal? @db.Decimal(6, 1)
  created_at        DateTime @default(now()) @db.Timestamptz()
  updated_at        DateTime @updatedAt @default(now()) @db.Timestamptz()

  owner           User?          @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  journal_entries JournalEntry[]
  favorited_by    FavoriteFood[]

  @@index([owner_id])
  @@index([name])
  @@map("food_items")
}

/// É3 — one journal line: a food eaten at a meal on a day. kcal/macros are a
/// snapshot computed at write time from quantity × per-100g values.
model JournalEntry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  food_item_id String   @db.Uuid
  meal         String   @db.VarChar(12) // breakfast | lunch | dinner | snack
  quantity_g   Decimal  @db.Decimal(7, 1)
  eaten_on     DateTime @db.Date
  kcal         Decimal  @db.Decimal(8, 2)
  protein_g    Decimal  @db.Decimal(7, 2)
  carbs_g      Decimal  @db.Decimal(7, 2)
  fat_g        Decimal  @db.Decimal(7, 2)
  created_at   DateTime @default(now()) @db.Timestamptz()

  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  food_item FoodItem @relation(fields: [food_item_id], references: [id])

  @@index([user_id, eaten_on])
  @@map("journal_entries")
}

/// É3 — user's starred foods for one-tap logging.
model FavoriteFood {
  user_id      String   @db.Uuid
  food_item_id String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz()

  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  food_item FoodItem @relation(fields: [food_item_id], references: [id], onDelete: Cascade)

  @@id([user_id, food_item_id])
  @@map("favorite_foods")
}

/// Generic audit trail written by the kit's AuditInterceptor.
model AuditLog {
  id            String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?  @db.Uuid
  action        String   @db.VarChar(100)
  resource_type String   @db.VarChar(50)
  resource_id   String?  @db.Uuid
  ip_address    String?  @db.Inet
  user_agent    String?
  changes       Json     @db.JsonB
  timestamp     DateTime @default(now()) @db.Timestamptz()

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@id([id, timestamp])
  @@index([user_id, timestamp])
  @@map("audit_logs")
}

// =============================================================================
// OFFLINE-FIRST SYNC — model shapes for @platform/service-kit's SyncEngine
// (idempotent replay + entity versioning; see the offline-first-mobile skill)
// =============================================================================

model OfflineQueue {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @db.Uuid
  device_id           String    @db.VarChar(200)
  client_op_id        String    @unique @db.Uuid
  operation_type      String    @db.VarChar(20)
  entity_type         String    @db.VarChar(40)
  entity_id           String?   @db.Uuid
  payload             Json      @db.JsonB
  priority            Int       @default(3)
  status              String    @default("pending") @db.VarChar(20)
  conflict_resolution String    @default("server_wins") @db.VarChar(30)
  expected_version    Int?
  client_timestamp    DateTime  @db.Timestamptz()
  server_received_at  DateTime  @default(now()) @db.Timestamptz()
  processed_at        DateTime? @db.Timestamptz()
  expires_at          DateTime  @db.Timestamptz()
  retry_count         Int       @default(0)
  error_message       String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status, priority])
  @@index([entity_type, entity_id])
  @@index([expires_at])
  @@map("offline_queue")
}

model EntityVersion {
  entity_type String   @db.VarChar(40)
  entity_id   String   @db.Uuid
  version     BigInt   @default(1)
  updated_at  DateTime @default(now()) @db.Timestamptz()

  @@id([entity_type, entity_id])
  @@map("entity_versions")
}
