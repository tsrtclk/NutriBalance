{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@platform/shared-types": ["packages/shared-types/src"],
      "@platform/shared-types/*": ["packages/shared-types/src/*"],
      "@platform/domain": ["packages/domain/src"],
      "@platform/domain/*": ["packages/domain/src/*"],
      "@platform/prisma-client": ["packages/prisma-client/src"],
      "@platform/events": ["packages/events/src"],
      "@platform/events/*": ["packages/events/src/*"],
      "@platform/service-kit": ["packages/service-kit/src"],
      "@platform/service-kit/*": ["packages/service-kit/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
